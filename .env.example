# Copy this file to `.env` and fill in your secrets. `.env` is gitignored.

# --- LLM providers ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- WHO ICD-11 API ---
# Register at https://icd.who.int/icdapi to get credentials.
# Token endpoint: https://icdaccessmanagement.who.int/connect/token
ICD11_CLIENT_ID=
ICD11_CLIENT_SECRET=
ICD11_API_VERSION=v2
ICD11_LANGUAGE=en
# Pick a release ID. Use "2024-01" or check the API for the latest release.
ICD11_RELEASE_ID=2024-01

# --- Local paths ---
# Override if you want caches/data outside the repo (recommended for big files).
ICD_DATA_DIR=./data
ICD_CACHE_DIR=./data/.cache

# --- Budget guardrails ---
# Soft daily token budget (USD). Scripts that bust this should refuse to run.
DAILY_LLM_BUDGET_USD=5.00
